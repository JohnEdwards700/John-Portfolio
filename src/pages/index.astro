---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectSketch from '../components/ProjectSketch.astro';
import { education, profile } from '../data/profile';

const base = import.meta.env.BASE_URL;
const [projectEntries, experienceEntries] = await Promise.all([
  getCollection('projects'),
  getCollection('experience'),
]);
const projects = projectEntries
  .sort((a, b) => (a.data.featuredOrder ?? Number.MAX_SAFE_INTEGER) - (b.data.featuredOrder ?? Number.MAX_SAFE_INTEGER));
const experiences = experienceEntries
  .sort((a, b) => (a.data.featuredOrder ?? Number.MAX_SAFE_INTEGER) - (b.data.featuredOrder ?? Number.MAX_SAFE_INTEGER));

const skills = [
  ['Languages', 'Python · Java · JavaScript · C# · Go · SQL · Rust · C · MATLAB · Racket'],
  ['Frameworks', 'React · ASP.NET · Node.js · Express'],
  ['Tools & systems', 'Git · MongoDB · Azure SQL · Linux · FFmpeg · Google Apps Script · Slate CRM'],
];
const courses = ['Algorithms', 'Theory of Computation', 'Software Engineering', 'Databases', 'Networking and Cryptography', 'Machine Learning'];
const projectHref = (slug: string) => `${base}projects/${slug}/`;
const experienceHref = (slug: string) => `${base}experience/${slug}/`;
const field = (value: unknown) => typeof value === 'string' ? value : '';
const list = (value: unknown): string[] => Array.isArray(value) ? value.filter((item): item is string => typeof item === 'string') : [];
---

<BaseLayout title="John Edwards — Software Engineer" description={profile.heroIntro} showChrome={false}>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="header-inner">
      <a class="wordmark" href={`${base}`} aria-label="John Edwards home">JE<span> / field notes</span></a>
      <nav aria-label="Main navigation">
        <a href="#work">Selected work</a>
        <a href="#experience">Experience</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </nav>
      <a class="resume-link" href={`${base}resume.pdf`} target="_blank" rel="noreferrer">Resume <span aria-hidden="true">↗</span></a>
    </div>
  </header>

  <main id="main">
    <section class="hero page-wrap" aria-labelledby="intro-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> Software &amp; systems · Dallas, Texas</p>
        <h1 id="intro-title">Software<br /><em>engineer.</em></h1>
        <p class="hero-intro">{profile.heroIntro}</p>
        <p class="hero-summary">{profile.heroSummary}</p>
        <div class="hero-actions">
          <a class="button button-dark" href="#work">Read the field notes <span aria-hidden="true">↓</span></a>
          <a class="text-link" href={`mailto:${profile.email}`}>Get in touch <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-caption"><span>01—{String(projects.length).padStart(2, '0')}</span> A working record of software, experiments, and decisions.</div>
      </div>
      <aside class="hero-aside" aria-label="Profile details">
        <div class="portrait-frame">
          <img src={`${base}profile.jpg`} alt="Portrait of John Edwards" width="2321" height="3024" fetchpriority="high" />
          <span class="photo-note">John Edwards <span>· Computer science</span></span>
        </div>
        <div class="aside-note"><span class="note-mark">↳</span><p>Interested in the seam between dependable backend systems and clear, useful interfaces.</p></div>
      </aside>
    </section>

    <section class="work-section" id="work" aria-labelledby="work-title">
      <div class="page-wrap">
        <div class="section-head">
          <div><p class="eyebrow">Selected work / 01—{String(projects.length).padStart(2, '0')}</p><h2 id="work-title">Projects, with the thinking left in.</h2></div>
          <p class="section-note">A few different problems, approached with care for the system and the person using it.</p>
        </div>
        {projects.length > 0 && <nav class="project-index" aria-label="Jump to a project">
          <span class="index-label">Index</span>
          {projects.map((project, index) => <a href={`#project-${project.id}`}><span>{String(index + 1).padStart(2, '0')}</span>{project.data.title}</a>)}
        </nav>}
        <div class="project-list">
          {projects.map((project, index) => {
            const data = project.data;
            const technologies = list(data.technologies);
            const contributions = list(data.keyContributions);
            return <article class="project-entry" id={`project-${project.id}`}>
              <div class="entry-number">{String(index + 1).padStart(2, '0')}<span> / PROJECT</span></div>
              <div class="entry-main">
                <div class="entry-meta"><span>{field(data.timeframe)}</span>{field(data.status) && <span class="status-label">{field(data.status)}</span>}</div>
                <h3><a href={projectHref(project.id)}>{data.title}<span class="heading-arrow" aria-hidden="true">↗</span></a></h3>
                {data.subtitle && <p class="entry-subtitle">{data.subtitle}</p>}
                <p class="entry-summary">{data.summary}</p>
                {contributions.length > 0 && <div class="contribution"><span class="eyebrow">My contribution</span><p>{contributions[0]}</p></div>}
                <ul class="tag-list" aria-label="Technologies">{technologies.map((technology) => <li>{technology}</li>)}</ul>
                <div class="entry-links"><a href={projectHref(project.id)}>Read project notes <span aria-hidden="true">→</span></a>
                  {data.demoUrl && <a href={data.demoUrl} target="_blank" rel="noreferrer">Live demo ↗</a>}
                  {data.sourceUrl && <a href={data.sourceUrl} target="_blank" rel="noreferrer">Source ↗</a>}
                  {data.artifactUrl && <a href={data.artifactUrl} target="_blank" rel="noreferrer">{data.artifactLabel || 'View project artifact'} ↗</a>}
                </div>
              </div>
              <aside class="margin-note"><span class="note-rule"></span><span class="eyebrow">In the margins</span><p>{field(data.outcome) || contributions[1] || 'A closer look at the decisions, constraints, and implementation.'}</p>
                <ProjectSketch slug={project.id} compact />
                {data.image && <img src={`${base}${String(data.image).replace(/^\//, '')}`} alt={field(data.imageAlt) || data.title} loading="lazy" />}
              </aside>
            </article>;
          })}
          {projects.length === 0 && <p class="empty-note">Project notes are being organized.</p>}
        </div>
      </div>
    </section>

    <section class="experience-section" id="experience" aria-labelledby="experience-title">
      <div class="page-wrap">
        <div class="section-head">
          <div><p class="eyebrow">Work log / experience</p><h2 id="experience-title">Work built with other people.</h2></div>
          <p class="section-note">Engineering is a team activity: listening to the workflow matters as much as writing the code.</p>
        </div>
        <div class="experience-list">
          {experiences.map((experience, index) => <article class="experience-entry">
            <span class="entry-number">{String(index + 1).padStart(2, '0')}</span>
            <div><p class="entry-meta">{field(experience.data.timeframe)} · {field(experience.data.location)}</p><h3><a href={experienceHref(experience.id)}>{experience.data.title}<span class="heading-arrow" aria-hidden="true">↗</span></a></h3><p class="experience-org">{field(experience.data.organization) || field(experience.data.subtitle)}</p><p class="entry-summary">{experience.data.summary}</p></div>
            <a class="small-arrow" href={experienceHref(experience.id)} aria-label={`Read ${experience.data.title} experience notes`}>↗</a>
          </article>)}
          {experiences.length === 0 && <p class="empty-note">Experience notes are being organized.</p>}
        </div>
      </div>
    </section>

    <section class="about-section" id="about" aria-labelledby="about-title">
      <div class="page-wrap about-grid">
        <div><p class="eyebrow">About / useful context</p><h2 id="about-title">Curious about how the pieces fit.</h2><p class="about-copy">My work moves between backend APIs, data systems, frontend experiences, and machine learning experiments. I like understanding the whole workflow before deciding what to build.</p><div class="education-note"><span class="eyebrow">Education</span><p><strong>{education.degree}</strong><br />{education.school} · {education.timeframe}</p></div></div>
        <div class="toolkit"><p class="eyebrow">Tools I reach for</p>{skills.map(([label, items]) => <div class="skill-row"><h3>{label}</h3><p>{items}</p></div>)}<div class="course-note"><span class="eyebrow">Coursework</span><p>{courses.join(' · ')}</p></div></div>
      </div>
    </section>
  </main>

  <footer id="contact" class="site-footer">
    <div class="page-wrap footer-inner"><div><p class="eyebrow">Open notebook / contact</p><h2>Have a problem worth untangling?</h2><a class="footer-email" href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a></div><div class="footer-links"><a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a><a href={profile.github} target="_blank" rel="noreferrer">GitHub ↗</a><a href={`${base}resume.pdf`} target="_blank" rel="noreferrer">Resume PDF ↗</a></div><p class="copyright">© {new Date().getFullYear()} {profile.name} <span>Notes made with care.</span></p></div>
  </footer>
</BaseLayout>

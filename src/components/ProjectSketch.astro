---
const { slug, compact = false } = Astro.props;

const paths = {
  'document-management-system': ['React interface', 'Go API', 'MongoDB'],
  'elephant-noise-cleanup': ['Annotated audio', 'Spectral subtraction', 'Audio + plots'],
  '2026-sequence-pattern-discovery-research': ['WGS sequences', 'ESM-2 embeddings', 'Clustering'],
  'reinforcement-learning-drone-simulation': ['Simulation state', 'PPO policy', 'Flight path'],
};

const steps = paths[slug];
---

{steps && <figure class:list={['project-sketch', { compact }]}>
  <figcaption>System path <span>· simplified from project documentation</span></figcaption>
  <ol>
    {steps.map((step) => <li>{step}</li>)}
  </ol>
</figure>}

<style>
  .project-sketch { margin: 0 0 3rem; border-top: 1px solid var(--rule); padding-top: 1rem; }
  figcaption { font: 10px var(--mono); text-transform: uppercase; letter-spacing: .07em; color: var(--rust); }
  figcaption span { text-transform: none; letter-spacing: 0; color: var(--muted); }
  ol { list-style: none; padding: 0; margin: 1.1rem 0 0; display: flex; align-items: center; gap: .45rem; }
  li { position: relative; flex: 1; min-width: 0; border-top: 2px solid var(--rust); padding: .7rem .15rem 0; font: 11px/1.35 var(--mono); color: var(--ink); }
  li + li::before { content: '→'; position: absolute; left: -.55rem; top: -.65rem; color: var(--rust); }
  .compact { margin: 1.2rem 0 0; }
  .compact ol { display: block; margin-top: .7rem; }
  .compact li { border-top: 0; border-left: 2px solid var(--rust); padding: .25rem 0 .25rem .7rem; }
  .compact li + li::before { content: '↓'; left: -.28rem; top: -.45rem; background: var(--paper); }
  @media (max-width: 600px) { ol { display: block; } li { border-top: 0; border-left: 2px solid var(--rust); padding: .3rem 0 .3rem .8rem; } li + li::before { content: '↓'; left: -.28rem; top: -.45rem; background: var(--paper); } }
</style>
